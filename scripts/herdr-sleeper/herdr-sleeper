# -------------------------------------------------------------------- install

def launchd_plist(script: Path, values: dict, env: dict[str, str]) -> bytes:
    """The launchd job, built with plistlib so paths with &, < or spaces stay valid XML."""
    path = f"{Path.home()}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    if env.get("HERDR_SLEEPER_HERDR_BIN"):
        path = os.path.dirname(env["HERDR_SLEEPER_HERDR_BIN"]) + ":" + path
    job = {
        "Label": LAUNCHD_LABEL,
        "ProgramArguments": [sys.executable, str(script), "scan"],
        "StartInterval": int(values["interval_minutes"]) * 60,
        "RunAtLoad": False,
        "EnvironmentVariables": {"PATH": path, **env},
        "StandardOutPath": str(STATE_DIR / "launchd.log"),
        "StandardErrorPath": str(STATE_DIR / "launchd.log"),
    }
    return plistlib.dumps(job)


def sleeper_env() -> dict[str, str]:
    """Settings that live in this shell's environment, so the scheduled job inherits the same config."""
    keep = ("HERDR_SLEEPER_IDLE_HOURS", "HERDR_SLEEPER_IDLE", "HERDR_SLEEPER_EXCLUDE", "HERDR_SLEEPER_INTERVAL_MINUTES",
            "HERDR_SLEEPER_STATE", "HERDR_SLEEPER_LAUNCHD_LABEL", "XDG_CONFIG_HOME")
    env = {k: os.environ[k] for k in keep if k in os.environ}
    herdr_path = shutil.which("herdr") or (HERDR_BIN if os.path.isabs(HERDR_BIN) else None)
    if herdr_path:  # the scheduler's PATH is not the shell's: pin the binary we resolved here
        env["HERDR_SLEEPER_HERDR_BIN"] = herdr_path
    return env


def cron_line(script: Path, minutes: int, env: dict[str, str] | None = None) -> str | None:
    """A crontab line for the interval, or None when cron's minute field cannot express it exactly."""
    prefix = ["env", *(f"{k}={v}" for k, v in sorted((env or {}).items()))] if env else []
    cmd = shlex.join([*prefix, sys.executable, str(script), "scan"]).replace("%", "\\%")
    if minutes < 60 and 60 % minutes == 0:
        return f"*/{minutes} * * * * {cmd}"
    if minutes % 60 == 0 and (minutes // 60) <= 24 and 24 % (minutes // 60) == 0:
        return f"0 */{minutes // 60} * * * {cmd}"
    return None


def cmd_install(args: argparse.Namespace) -> int:
    if args.config_error:
        say(f"error: refusing to install with a broken config — {args.config_error}")
        return 2
    values = dict(args.config_values)
    if args.interval_minutes is not None:
        if args.interval_minutes < 1:
            say("error: --interval-minutes must be >= 1")
            return 2
        values["interval_minutes"] = args.interval_minutes
    script = Path(__file__).resolve()
    if platform.system() != "Darwin":
        line = cron_line(script, values["interval_minutes"], sleeper_env())
        if line is None:
            print(f"{values['interval_minutes']} min is not expressible as a cron interval; "
                  "use a divisor of 60 minutes or a divisor of 24 hours")
            return 1
        print(f"no launchd here; add to crontab:\n{line}")
        return 0
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAUNCHD_PLIST.parent.mkdir(parents=True, exist_ok=True)
    env = sleeper_env()
    if not env.get("HERDR_SLEEPER_HERDR_BIN"):
        print("cannot find the `herdr` binary to pin for the scheduled job; set HERDR_SLEEPER_HERDR_BIN")
        return 1
    new_plist = launchd_plist(script, values, env)
    previous = LAUNCHD_PLIST.read_bytes() if LAUNCHD_PLIST.exists() and not LAUNCHD_PLIST.is_symlink() else None
    if LAUNCHD_PLIST.is_symlink():
        LAUNCHD_PLIST.unlink()  # replace a repo-symlinked plist with the generated one
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LAUNCHD_LABEL}"], capture_output=True)
    LAUNCHD_PLIST.write_bytes(new_plist)
    proc = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(LAUNCHD_PLIST)], capture_output=True, text=True)
    if proc.returncode:
        print(f"launchctl bootstrap failed: {proc.stderr.strip()}")
        if previous is not None:  # put the job that was working back
            LAUNCHD_PLIST.write_bytes(previous)
            subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(LAUNCHD_PLIST)], capture_output=True)
            print("previous job restored")
        return 1
    say(f"installed {LAUNCHD_LABEL}: scan every {values['interval_minutes']} min, idle {values['idle_hours']:g}h, "
        f"exclude {values['exclude']}" + (f", env {sorted(env)}" if env else ""))
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    if platform.system() != "Darwin":
        print("remove the crontab line for herdr-sleeper")
        return 0
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LAUNCHD_LABEL}"], capture_output=True)
    if LAUNCHD_PLIST.exists() or LAUNCHD_PLIST.is_symlink():
        LAUNCHD_PLIST.unlink()
    say(f"uninstalled {LAUNCHD_LABEL}")
    return 0


# ----------------------------------------------------------------------- main

def main(argv: list[str] | None = None) -> int:
    global QUIET_STDOUT
    config_error = None
    try:
        cfg, cfg_source = load_config()
    except ConfigError as exc:
        config_error, cfg, cfg_source = str(exc), dict(DEFAULTS), {k: "default" for k in DEFAULTS}

    parser = argparse.ArgumentParser(prog="herdr-sleeper", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    scan = sub.add_parser("scan", help="sleep every eligible idle agent")
    scan.add_argument("--idle", metavar="DURATION", help="idle window such as 12h, 90m, 1d (overrides --idle-hours)")
    scan.add_argument("--idle-hours", type=idle_hours_arg, default=cfg["idle_hours"],
                      help=f"idle window in hours (default {cfg['idle_hours']:g}; see `herdr-sleeper config`)")
    scan.add_argument("--dry-run", action="store_true", help="run every check including the composer, act on nothing")
    scan.add_argument("--only", nargs="+", metavar="PANE_OR_NAME", help="restrict to these panes/agents")
    scan.add_argument("--exclude", nargs="+", metavar="PANE_OR_NAME", default=cfg["exclude"],
                      help=f"never sleep these, e.g. orchestrators idle awaiting mail (default {cfg['exclude']})")
    scan.add_argument("--json", action="store_true")
    scan.set_defaults(fn=cmd_scan)

    wake = sub.add_parser("wake", help="restart a slept agent with --resume")
    wake.add_argument("target", nargs="?", help="agent name or pane id")
    wake.add_argument("--all", action="store_true")
    wake.set_defaults(fn=cmd_wake)

    lst = sub.add_parser("list", help="show sleeping agents")
    lst.add_argument("--json", action="store_true")
    lst.set_defaults(fn=cmd_list)

    logp = sub.add_parser("log", help="what has been slept / woken / refused")
    logp.add_argument("-n", type=int, default=30)
    logp.add_argument("--json", action="store_true")
    logp.set_defaults(fn=cmd_log)

    conf = sub.add_parser("config", help="effective settings and their sources")
    conf.add_argument("--json", action="store_true")
    conf.set_defaults(fn=cmd_config)

    inst = sub.add_parser("install", help="schedule `scan` (launchd on macOS; prints a cron line elsewhere)")
    inst.add_argument("--interval-minutes", type=int)
    inst.set_defaults(fn=cmd_install)
    sub.add_parser("uninstall", help="remove the schedule").set_defaults(fn=cmd_uninstall)

    args = parser.parse_args(argv)
    args.config_error, args.config_values, args.config_source = config_error, cfg, cfg_source
    QUIET_STDOUT = bool(getattr(args, "json", False))
    if args.cmd == "wake" and not args.all and not args.target:
        wake.error("give a name/pane id or --all")
    if args.cmd == "scan" and args.idle:
        try:
            args.idle_hours = parse_duration(args.idle)
        except ConfigError as exc:
            scan.error(str(exc))
    try:
        return args.fn(args)
    except (SleeperError, OSError) as exc:
        say(f"error: {exc}")
        return 2


if __name__ == "__main__":
    sys.exit(main())
