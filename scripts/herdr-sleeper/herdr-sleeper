class ConfigError(Exception):
    pass


class SleeperError(RuntimeError):
    pass


def idle_hours_arg(text: str) -> float:
    """argparse type for --idle-hours: a finite, non-negative number."""
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {text!r}")
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"idle hours must be finite and >= 0, got {text!r}")
    return value


# --------------------------------------------------------------------------- io

def log(msg: str) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as fh:
            fh.write(f"{dt.datetime.now().isoformat(timespec='seconds')} {msg}\n")
    except OSError:
        pass  # a missing log must never stop the message reaching stdout/stderr


QUIET_STDOUT = False  # --json: diagnostics go to stderr so stdout stays one JSON document


def say(msg: str) -> None:
    print(msg, file=sys.stderr if QUIET_STDOUT else sys.stdout)
    log(msg)


def event(kind: str, **fields: object) -> None:
    """Append one structured record to events.jsonl (what `herdr-sleeper log` shows)."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        rec = {"at": dt.datetime.now().isoformat(timespec="seconds"), "event": kind, **fields}
        with EVENTS.open("a") as fh:
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
    except OSError as exc:
        log(f"WARN could not write event: {exc}")


def write_json(path: Path, data: object) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)


def read_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise SleeperError(f"{path} is unreadable ({exc}); refusing to act on a damaged state file")
    if not isinstance(data, dict):
        raise SleeperError(f"{path} does not hold a JSON object; refusing to act on a damaged state file")
    return data


class locked:
    """Interprocess lock around a whole scan/wake transaction (launchd + a manual run may overlap)."""

    def __enter__(self) -> "locked":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.fh = LOCK.open("a+")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("another herdr-sleeper holds the lock; waiting")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc: object) -> None:
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


# ------------------------------------------------------------------ herdr calls

def herdr(*args: str, check: bool = True, timeout: float = HERDR_TIMEOUT) -> dict:
    """Run a `herdr` CLI command and return its parsed JSON `result`.

    Herdr prints `{"error": {...}}` with exit 0 on failure, so the envelope is
    what we trust, not the exit code. With check=False a failure returns {}.
    """
    try:
        proc = subprocess.run([HERDR_BIN, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            raise SleeperError(f"herdr {' '.join(args[:2])} timed out after {timeout}s")
        return {}
    except FileNotFoundError:
        raise SleeperError(f"`{HERDR_BIN}` not found (set HERDR_SLEEPER_HERDR_BIN or fix PATH)")
    out = proc.stdout.strip()
    payload: dict | None = None
    if out.startswith("{"):
        try:
            payload = json.loads(out)
        except json.JSONDecodeError:
            payload = None
    if payload is None or "error" in payload or proc.returncode != 0:
        if check:
            detail = (payload or {}).get("error") or proc.stderr.strip() or out[:200] or f"exit {proc.returncode}"
            raise SleeperError(f"herdr {' '.join(args[:2])} failed: {detail}")
        return {}
    result = payload.get("result")
    if not isinstance(result, dict):
        if check:
            raise SleeperError(f"herdr {' '.join(args[:2])}: malformed envelope (result is {type(result).__name__})")
        return {}
    return result


def herdr_screen(pane: str) -> str | None:
    """The pane's screen as plain text, or None when it could not be read."""
    try:
        proc = subprocess.run([HERDR_BIN, "pane", "read", pane], capture_output=True, text=True, timeout=HERDR_TIMEOUT)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if proc.returncode != 0 or proc.stdout.lstrip().startswith('{"error"'):
        return None
    return proc.stdout


def list_agents() -> list[dict]:
    agents = herdr("agent", "list").get("agents")
    if not isinstance(agents, list) or not all(isinstance(a, dict) and isinstance(a.get("pane_id"), str) for a in agents):
        raise SleeperError("herdr agent list: malformed agents payload")
    return agents


def valid_entry(entry: object) -> bool:
    """A journal/snapshot entry we are willing to act on."""
    return isinstance(entry, dict) and isinstance(entry.get("pane_id"), str) and isinstance(entry.get("uuid"), str)


# --------------------------------------------------------------------- config

def parse_duration(text: str) -> float:
    """'12h', '90m', '1d', '1.5h', or a bare number of hours → hours."""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*", str(text))
    if not m:
        raise ConfigError(f"bad duration {text!r}; use e.g. 12h, 90m, 1d")
    n, unit = float(m.group(1)), m.group(2) or "h"
    return n * {"s": 1 / 3600, "m": 1 / 60, "h": 1.0, "d": 24.0}[unit]


def load_config() -> tuple[dict, dict[str, str]]:
    """Effective settings and, per key, where each value came from. Raises ConfigError."""
    values = dict(DEFAULTS)
    source = {k: "default" for k in DEFAULTS}
    if CONFIG_FILE.exists():
        try:
            raw = tomllib.loads(CONFIG_FILE.read_text())
        except (OSError, tomllib.TOMLDecodeError) as exc:
            raise ConfigError(f"{CONFIG_FILE}: {exc}")
        for k, v in raw.items():
            if k == "idle":
                values["idle_hours"], source["idle_hours"] = parse_duration(v), str(CONFIG_FILE)
            elif k in DEFAULTS:
                values[k], source[k] = v, str(CONFIG_FILE)
            else:
                raise ConfigError(f"{CONFIG_FILE}: unknown key {k!r}")
    env = {"idle_hours": "HERDR_SLEEPER_IDLE_HOURS", "idle": "HERDR_SLEEPER_IDLE", "exclude": "HERDR_SLEEPER_EXCLUDE",
           "interval_minutes": "HERDR_SLEEPER_INTERVAL_MINUTES"}
    if "HERDR_SLEEPER_IDLE" in os.environ and "HERDR_SLEEPER_IDLE_HOURS" in os.environ:
        raise ConfigError("set only one of HERDR_SLEEPER_IDLE and HERDR_SLEEPER_IDLE_HOURS")
    for k, var in env.items():
        if var in os.environ:
            raw_v = os.environ[var]
            key = "idle_hours" if k == "idle" else k
            values[key] = raw_v.split() if k == "exclude" else parse_duration(raw_v) if k in ("idle", "idle_hours") else raw_v
            source[key] = f"${var}"
    # validation: a bad config must never mean "no excludes" or "sleep everything"
    for key in ("idle_hours", "interval_minutes"):
        if isinstance(values[key], bool):  # TOML `false` would otherwise become 0.0 = sleep everything
            raise ConfigError(f"{key} must be a number, not a boolean")
    try:
        values["idle_hours"] = float(values["idle_hours"])
        values["interval_minutes"] = int(values["interval_minutes"])
    except (TypeError, ValueError) as exc:
        raise ConfigError(f"idle_hours/interval_minutes must be numbers: {exc}")
    if not math.isfinite(values["idle_hours"]) or values["idle_hours"] < 0:
        raise ConfigError(f"idle_hours must be a finite number >= 0, got {values['idle_hours']!r}")
    if values["interval_minutes"] < 1:
        raise ConfigError("interval_minutes must be >= 1")
    ex = values["exclude"]
    if isinstance(ex, str):
        ex = [ex]
    if not isinstance(ex, list) or not all(isinstance(x, str) for x in ex):
        raise ConfigError("exclude must be a list of strings")
    values["exclude"] = ex
    return values, source


# ------------------------------------------------------------------ inspection

def transcript_for(uuid: str) -> Path | None:
    """The transcript for a session; when several match, the most recently written one."""
    hits = [Path(p) for p in glob.glob(str(TRANSCRIPTS / "*" / f"{uuid}.jsonl"))]
    if not hits:
        return None
    try:
        return max(hits, key=lambda p: p.stat().st_mtime)
    except OSError:
        return None


def claude_process(pane: str) -> tuple[bool | None, list[str] | None]:
    """(present, argv_after_argv0) for the claude process controlling the pane.

    present is True/False when process-info answered, None when it could not
    be read — an unknown must never be mistaken for "gone".
    """
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None, None
    for proc in info["foreground_processes"]:
        argv = proc.get("argv") or []
        if argv and (os.path.basename(argv[0]) == "claude" or proc.get("name") == "claude"):
            return True, list(argv[1:])
    return False, None


def claude_argv(pane: str) -> list[str] | None:
    return claude_process(pane)[1]


def replayable_argv(args: list[str]) -> tuple[list[str] | None, str | None]:
    """Strip session-selection flags; refuse argv that would fork the session or re-run work.

    Returns (argv_to_replay, refusal_reason).
    """
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return None, "argv contains `--` (positional input would be replayed)"
        if a in REFUSED_OPTIONS or a.split("=", 1)[0] in REFUSED_OPTIONS:
            return None, f"argv contains {a} (not safely replayable)"
        if a in ("--resume", "-r"):
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1  # drop its value too
            i += 1
            continue
        if a.startswith("--resume=") or a in ("--continue", "-c"):
            i += 1
            continue
        if a in BOOLEAN_OPTIONS:
            out.append(a)
            i += 1
            continue
        base = a.split("=", 1)[0]
        if base in VALUE_OPTIONS:
            out.append(a)
            if "=" not in a:
                if i + 1 >= len(args):
                    return None, f"{a} is missing its value"
                out.append(args[i + 1])
                i += 1
            i += 1
            continue
        if a.startswith("-"):
            # an option we do not know the arity of: guessing could turn a prompt into a "value" and replay it
            return None, f"argv has unrecognised option {a} (add it to VALUE_OPTIONS/BOOLEAN_OPTIONS if it is safe)"
        return None, f"argv has positional input {a!r} (an initial prompt would be re-sent on wake)"
    return out, None


def composer_state(screen: str | None) -> tuple[str, str]:
    """('empty' | 'draft' | 'unknown', detail) judged from the pane screen, failing closed.

    The composer is the last line starting with a prompt glyph. Text after
    the glyph, or any non-footer line below it, is a draft. No glyph at all,
    or no screen, is unknown — we refuse rather than guess.
    """
    if screen is None:
        return "unknown", "screen unreadable"
    lines = [ln.rstrip() for ln in screen.splitlines() if ln.strip()]
    for idx in range(len(lines) - 1, -1, -1):
        stripped = lines[idx].lstrip()
        if stripped.startswith(PROMPT_GLYPHS):
            draft = stripped[1:].strip()
            if draft:
                return "draft", draft[:60]
            rest = [ln.strip() for ln in lines[idx + 1:]]
            below = [ln for ln in rest if not (ln.startswith(FOOTER_PREFIXES) or set(ln) <= {"─"})]
            if below:
                return "draft", below[0][:60]
            if not rest:  # a bare glyph with nothing rendered under it is not a composer we can vouch for
                return "unknown", "no footer below the prompt"
            return "empty", ""
        if stripped.startswith(("⏺", "✻", "⎿")):
            return "unknown", "composer not visible below transcript"
    return "unknown", "no prompt glyph on screen"


def uuid_live_elsewhere(uuid: str, except_pane: str | None = None, cwd: str | None = None) -> str | None:
    """Where this session is already running ('pane w1:p2', 'pid 123'); None if verified nowhere.

    Raises SleeperError when that cannot be verified — an unknown answer must
    not authorise a resume, which would fork the session.
    """
    try:
        agents = list_agents()
    except SleeperError as exc:
        raise SleeperError(f"cannot verify session liveness: {exc}")
    for a in agents:
        if a["pane_id"] != except_pane and (a.get("agent_session") or {}).get("value") == uuid:
            return f"pane {a['pane_id']}"
    try:
        ps = subprocess.run(["ps", "-eo", "pid=,args="], capture_output=True, text=True, timeout=15, check=True).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        raise SleeperError(f"cannot verify session liveness: ps failed ({exc})")
    for line in ps.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        # a shell whose command text merely mentions the uuid is not a session; anything else that
        # selects the uuid on its command line (claude, node …/claude, node …/cli.js) is treated as one
        if os.path.basename(parts[1]) in ("bash", "sh", "zsh", "fish", "dash", "login"):
            continue
        selects = any(p == uuid or p.endswith("=" + uuid) for p in parts[2:])
        if selects:
            return f"pid {parts[0]}"
        if not any(os.path.basename(p) == "claude" for p in parts[1:3]):
            continue
        # `claude --continue` picks up the newest session in its cwd, which may be this one
        if cwd and any(p in ("--continue", "-c") for p in parts[2:]) and process_cwd(parts[0]) == cwd:
            return f"pid {parts[0]} (claude --continue in {cwd})"
    return None


def process_cwd(pid: str) -> str | None:
    try:
        out = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


def merge_snapshot(agents: list[dict]) -> None:
    """pane→uuid→argv for every claude pane, merged so that panes currently asleep keep their handle."""
    snap = read_json(SNAPSHOT)
    live_panes = {a["pane_id"] for a in agents}
    for a in agents:
        uuid = (a.get("agent_session") or {}).get("value")
        if a.get("agent") != "claude" or not uuid:
            continue
        present, argv = claude_process(a["pane_id"])
        prior = snap.get(a["pane_id"]) or {}
        if argv is None and present is None and prior.get("uuid") == uuid:
            argv = prior.get("argv")  # process-info hiccup: keep what we knew rather than erase it
        snap[a["pane_id"]] = {"uuid": uuid, "name": a.get("name"), "cwd": a.get("cwd"),
                              "title": a.get("terminal_title_stripped"), "argv": argv,
                              "seen_at": dt.datetime.now().isoformat(timespec="seconds")}
    for pane in list(snap):  # a pane now running a *different* session is no longer recoverable to the old one
        if pane in live_panes and snap[pane]["uuid"] not in {
            (a.get("agent_session") or {}).get("value") for a in agents if a["pane_id"] == pane
        }:
            snap.pop(pane)
    write_json(SNAPSHOT, snap)


def agent_target(agent: dict) -> str:
    return agent.get("name") or agent["pane_id"]


def wake_name(entry: dict) -> str:
    return entry.get("name") or "wake-" + entry["pane_id"].replace(":", "-")


def manual_command(entry: dict) -> str:
    argv, _why = replayable_argv(entry.get("argv") or [])
    return f"cd {shlex.quote(entry.get('cwd') or '.')} && " + shlex.join(
        ["claude", *(argv or []), "--resume", entry["uuid"]])


# ---------------------------------------------------------------- assessment

def assess(agent: dict, all_agents: list[dict], idle_hours: float, journal: dict,
           exclude: set[str] | None = None) -> tuple[bool, str, float | None]:
    """Decide whether one agent may be slept. Returns (ok, reason, idle_hours)."""
    pane = agent["pane_id"]
    if exclude and (pane in exclude or agent.get("name") in exclude):
        return False, "excluded", None
    if pane in journal:
        return False, f"already in sleep journal ({journal[pane].get('phase', 'asleep')})", None
    if agent.get("agent") != "claude":
        return False, f"agent kind {agent.get('agent')!r} not supported", None
    uuid = (agent.get("agent_session") or {}).get("value")
    if not uuid:
        return False, "no session uuid (cannot resume)", None
    if agent.get("focused") is not False:  # missing/None must not read as "not focused"
        return False, "pane is focused (or focus unknown)", None
    status = agent.get("agent_status")
    if status not in SLEEPABLE_STATUSES:
        return False, f"status {status}", None
    others = [a for a in all_agents if a["pane_id"] != pane and (a.get("agent_session") or {}).get("value") == uuid]
    if others:
        return False, f"session also open in {', '.join(a['pane_id'] for a in others)}", None
    path = transcript_for(uuid)
    if path is None:
        return False, "no transcript on disk (cannot verify idle or resume)", None
    try:
        idle = (time.time() - path.stat().st_mtime) / 3600
    except OSError:
        return False, "transcript vanished while checking", None
    if idle < idle_hours:
        return False, f"idle {idle:.1f}h < {idle_hours:g}h", idle
    return True, f"idle {idle:.1f}h", idle


def recheck(agent: dict, idle_hours: float, journal: dict, exclude: set[str]) -> tuple[str | None, dict | None]:
    """Re-run every check against live state right before acting. Returns (reason_to_stop, live_agent)."""
    fresh = {a["pane_id"]: a for a in list_agents() if a.get("agent")}
    now = fresh.get(agent["pane_id"])
    if now is None:
        return "agent gone", None
    if now.get("state_change_seq") != agent.get("state_change_seq"):
        return f"state changed since scan ({agent.get('agent_status')} → {now.get('agent_status')})", now
    if (now.get("agent_session") or {}).get("value") != (agent.get("agent_session") or {}).get("value"):
        return "session changed since scan", now
    ok, reason, _ = assess(now, list(fresh.values()), idle_hours, journal, exclude)
    if not ok:
        return reason, now
    state, detail = composer_state(herdr_screen(agent["pane_id"]))
    if state != "empty":
        return f"composer {state}: {detail}", now
    return None, now


# ---------------------------------------------------------------------- sleep

def sleep_agent(agent: dict, idle_hours: float, exclude: set[str], dry_run: bool) -> tuple[bool, str]:
    """Try to sleep one agent. Returns (slept, outcome). Caller holds the lock."""
    pane = agent["pane_id"]
    uuid = agent["agent_session"]["value"]
    raw_argv = claude_argv(pane)
    if raw_argv is None:
        return False, "could not read claude argv from pane"
    argv, why = replayable_argv(raw_argv)
    if argv is None:
        return False, why or "argv not replayable"
    journal = read_json(JOURNAL)
    if dry_run:
        stop, _ = recheck(agent, idle_hours, journal, exclude)
        if stop:
            event("refused", pane=pane, name=agent.get("name"), uuid=uuid, reason=stop)
            return False, f"refused: {stop}"
        return False, "would sleep (dry run)"

    pane_info = herdr("pane", "get", pane).get("pane", {})
    label = pane_info.get("label") or None
    if label and label.startswith(SLEEP_MARK):
        label = label[len(SLEEP_MARK):] or None
    transcript = transcript_for(uuid)
    entry = {
        "pane_id": pane, "workspace_id": agent.get("workspace_id"), "tab_id": agent.get("tab_id"),
        "name": agent.get("name"), "label": label, "title": agent.get("terminal_title_stripped"),
        "cwd": agent.get("cwd"), "uuid": uuid, "transcript": str(transcript) if transcript else None,
        "argv": argv, "slept_at": dt.datetime.now().isoformat(timespec="seconds"), "phase": "exit-requested",
    }
    name = wake_name(entry)

    # 1. journal first, under the lock, re-read: if anything below fails the handle still exists.
    journal = read_json(JOURNAL)
    journal[pane] = entry
    write_json(JOURNAL, journal)

    # 2. the last look before acting — after the journal write, so nothing happens between check and act
    #    but the prompt itself. Targets the pane id: names can be renamed or reused under us.
    stop, _ = recheck(agent, idle_hours, {k: v for k, v in journal.items() if k != pane}, exclude)
    if stop:
        journal = read_json(JOURNAL)
        journal.pop(pane, None)
        write_json(JOURNAL, journal)
        event("refused", pane=pane, name=name, uuid=uuid, reason=stop)
        return False, f"refused: {stop}"
    herdr("agent", "prompt", pane, "/exit", check=False)

    # 3. "gone" needs positive evidence: Herdr no longer lists an agent AND process-info shows no claude.
    deadline = time.monotonic() + EXIT_WAIT_SECONDS
    gone = False
    while time.monotonic() < deadline:
        time.sleep(1)
        pane_now = herdr("pane", "get", pane, check=False).get("pane")
        present, _ = claude_process(pane)
        if isinstance(pane_now, dict) and "agent" not in pane_now and present is False:
            gone = True
            break
    if not gone:
        # A timeout is not proof the exit failed; keep the handle and let the next scan reconcile.
        say(f"WARN {pane}: agent still present {EXIT_WAIT_SECONDS}s after /exit; entry kept as exit-requested")
        event("exit-uncertain", pane=pane, name=name, uuid=uuid)
        return False, "exit uncertain; will reconcile next scan"

    journal = read_json(JOURNAL)
    if pane in journal:
        journal[pane]["phase"] = "asleep"
        write_json(JOURNAL, journal)

    # 3. reset terminal modes, then advertise the wake path in the pane and the sidebar label.
    hint = f"{SLEEP_MARK}slept by herdr-sleeper {entry['slept_at']} — wake: " + shlex.join(["herdr-sleeper", "wake", name])
    herdr("pane", "run", pane, f"printf '{MODE_RESET}'; clear; printf '%s\\n' {shlex.quote(hint)}", check=False)
    herdr("pane", "rename", pane, SLEEP_MARK + (label or entry["title"] or name), check=False)
    event("slept", pane=pane, name=name, uuid=uuid, title=entry["title"], cwd=entry["cwd"])
    return True, "slept"


def reconcile(agents: list[dict]) -> None:
    """Settle `exit-requested` entries and entries whose pane now runs the same session again."""
    journal = read_json(JOURNAL)
    by_pane = {a["pane_id"]: a for a in agents if a.get("agent")}  # a listed pane with no agent is not live
    changed = False
    for pane, entry in list(journal.items()):
        live = by_pane.get(pane)
        live_uuid = (live or {}).get("agent_session", {}).get("value") if live else None
        if not valid_entry(entry):
            say(f"reconcile {pane}: malformed journal entry left untouched")
            continue
        if live and live_uuid == entry["uuid"] and claude_process(pane)[0] is True:
            # seen running with a real process. Once could be Herdr lagging a slow exit; twice in a row is not.
            seen = int(entry.get("seen_running", 0)) + 1
            if seen < 2:
                entry["seen_running"] = seen
                changed = True
                continue
            say(f"reconcile {pane}: session {entry['uuid']} is running again (seen twice); dropping journal entry")
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="running")
            journal.pop(pane)
            changed = True
        elif live and live_uuid and live_uuid != entry["uuid"]:
            say(f"reconcile {pane}: now runs session {live_uuid}, not {entry['uuid']}; dropping journal entry")
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="replaced", by=live_uuid)
            journal.pop(pane)
            changed = True
        elif entry.get("phase") == "exit-requested" and not live and claude_process(pane)[0] is False:
            entry["phase"] = "asleep"
            entry.pop("seen_running", None)
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="asleep")
            changed = True
    if changed:
        write_json(JOURNAL, journal)


def cmd_scan(args: argparse.Namespace) -> int:
    if args.config_error:
        say(f"error: refusing to scan with a broken config — {args.config_error}")
        return 2
    exclude = set(args.config_values["exclude"]) | set(args.exclude)  # CLI adds to the config, never replaces it
    only = set(args.only or [])
    rows = []
    slept = 0
    with locked():
        agents = list_agents()
        merge_snapshot(agents)
        reconcile(agents)
        journal = read_json(JOURNAL)
        for agent in agents:
            if only and agent["pane_id"] not in only and agent.get("name") not in only:
                continue
            ok, reason, idle = assess(agent, agents, args.idle_hours, journal, exclude)
            outcome = reason
            if ok:
                try:
                    did, outcome = sleep_agent(agent, args.idle_hours, exclude, args.dry_run)
                except SleeperError as exc:  # one flaky pane must not starve the rest of the tick
                    did, outcome = False, f"error: {exc}"
                slept += did
                if did:
                    say(f"slept {agent['pane_id']} ({agent_target(agent)}) uuid={agent['agent_session']['value']}")
                else:
                    say(f"skip {agent['pane_id']}: {outcome}")
            rows.append({"pane": agent["pane_id"], "name": agent.get("name"), "status": agent.get("agent_status"),
                         "idle_hours": None if idle is None else round(idle, 1), "eligible": ok, "outcome": outcome})
    if args.json:
        print(json.dumps({"slept": slept, "dry_run": args.dry_run, "idle_hours": args.idle_hours, "agents": rows}, indent=2))
    else:
        for r in rows:
            mark = "SLEEP" if r["outcome"] == "slept" else "would" if r["outcome"].startswith("would") else "keep "
            print(f"{mark} {r['pane']:8} {(r['name'] or '-'):20} {r['status'] or '-':8} {r['outcome']}")
        print(f"{slept} slept, {len(rows)} inspected, idle window {args.idle_hours:g}h" + (" (dry run)" if args.dry_run else ""))
    return 0


# ----------------------------------------------------------------------- wake

def wake_entry(entry: dict) -> bool:
    """Wake one journaled pane. Caller holds the lock; the entry is already persisted."""
    if not valid_entry(entry):
        raise SleeperError(f"malformed journal entry: {json.dumps(entry)[:120]}")
    pane = entry["pane_id"]
    name = wake_name(entry)
    uuid = entry["uuid"]
    if entry.get("argv") is None:
        say(f"cannot wake {name}: original argv unknown; refusing to invent one. Manual: {manual_command(entry)}")
        return False
    argv, why = replayable_argv(entry["argv"])
    if argv is None:  # snapshot entries hold the raw argv; journal entries were filtered at sleep, harmless to repeat
        say(f"cannot wake {name}: {why}; entry kept. Manual: {manual_command(entry)}")
        return False
    entry = {**entry, "argv": argv}
    pane_info = herdr("pane", "get", pane, check=False).get("pane")
    if not pane_info:
        say(f"cannot wake {name}: pane {pane} no longer exists; entry kept. Manual: {manual_command(entry)}")
        return False
    if "agent" in pane_info:
        running = (pane_info.get("agent_session") or {}).get("value")
        if running == uuid and claude_process(pane)[0] is True:
            say(f"{name}: session {uuid} is already running in {pane}; clearing journal entry")
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            return True
        say(f"cannot wake {name}: pane {pane} still shows an agent (session {running}); entry kept")
        return False
    if claude_process(pane)[0] is not False:
        say(f"cannot wake {name}: cannot confirm pane {pane} is at a bare shell; entry kept")
        return False
    if entry.get("cwd") and pane_info.get("cwd") and pane_info["cwd"] != entry["cwd"]:
        say(f"cannot wake {name}: pane {pane} now lives in {pane_info['cwd']}, journal says {entry['cwd']} "
            f"(recycled pane id?); entry kept. Manual: {manual_command(entry)}")
        return False
    where = uuid_live_elsewhere(uuid, cwd=entry.get("cwd"))  # raises when it cannot tell
    if where:
        say(f"cannot wake {name}: session {uuid} is already live in {where}")
        return False
    if transcript_for(uuid) is None:
        say(f"cannot wake {name}: transcript for {uuid} is gone; entry kept. Manual: {manual_command(entry)}")
        return False
    cmd = ["agent", "start", name, "--kind", "claude", "--pane", pane, "--timeout", str(WAKE_TIMEOUT_MS),
           "--", *entry["argv"], "--resume", uuid]
    try:
        result = herdr(*cmd, timeout=WAKE_TIMEOUT_MS / 1000 + 30)
    except SleeperError as exc:
        say(f"wake {name} failed: {exc}; entry kept")
        event("wake-failed", pane=pane, name=name, uuid=uuid, reason=str(exc))
        return False
    got = (result.get("agent", {}).get("agent_session") or {}).get("value")
    journal = read_json(JOURNAL)
    if got != uuid:
        # a fresh session took the pane; keep the record so the old one stays reachable.
        if pane in journal:
            journal[pane].update(wake_failed_at=dt.datetime.now().isoformat(timespec="seconds"), wake_got=got)
            write_json(JOURNAL, journal)
        say(f"WARN {name}: pane now runs session {got}, expected {uuid}; entry kept. Manual: {manual_command(entry)}")
        event("wake-mismatch", pane=pane, name=name, uuid=uuid, got=got)
        return False
    # restore the label exactly as journaled at sleep time: a pane that had none gets none back
    if entry.get("label"):
        herdr("pane", "rename", pane, entry["label"], check=False)
    elif pane_info.get("label"):
        herdr("pane", "rename", pane, "--clear", check=False)  # bare `rename <pane>` is a usage error (verified)
    journal.pop(pane, None)
    write_json(JOURNAL, journal)
    say(f"woke {name} in {pane} uuid={got}")
    event("woke", pane=pane, name=name, uuid=got, slept_at=entry.get("slept_at"))
    return True


def cmd_wake(args: argparse.Namespace) -> int:
    with locked():
        try:
            journal = read_json(JOURNAL)
        except SleeperError as exc:
            if args.all:
                raise
            say(f"WARN {exc}; continuing with snapshot recovery only")
            journal = {}
        if args.all:
            targets = list(journal.values())
            if not targets:
                print("nothing is sleeping")
                return 0
        else:
            targets = [e for e in journal.values() if args.target in (e["pane_id"], wake_name(e), e.get("name"))]
            if not targets:
                # crash recovery: the pane→uuid snapshot from the last scan can stand in for a lost journal entry
                snap = read_json(SNAPSHOT)
                hits = [(p, s) for p, s in snap.items()
                        if args.target in (p, s.get("name"), "wake-" + p.replace(":", "-"))]
                if not hits:
                    print(f"no sleeping agent named {args.target!r}; try `herdr-sleeper list`")
                    return 1
                pane, snapped = hits[0]
                if not valid_entry({**snapped, "pane_id": pane}):
                    print(f"snapshot entry for {pane} is malformed; not recovering")
                    return 1
                pane_now = herdr("pane", "get", pane, check=False).get("pane")
                if not isinstance(pane_now, dict):
                    print(f"pane {pane} no longer exists; manual: {manual_command({**snapped, 'pane_id': pane})}")
                    return 1
                if "agent" in pane_now or claude_process(pane)[0] is not False:
                    print(f"pane {pane} is not at a bare shell; not recovering into it")
                    return 1
                if snapped.get("cwd") and pane_now.get("cwd") and pane_now["cwd"] != snapped["cwd"]:
                    print(f"pane {pane} now lives in {pane_now['cwd']}, snapshot was {snapped['cwd']}; not recovering "
                          f"into a reused pane. Manual: {manual_command({**snapped, 'pane_id': pane})}")
                    return 1
                say(f"{args.target!r} not in journal; recovering from panes.json snapshot ({snapped['seen_at']})")
                entry = {"pane_id": pane, "name": snapped.get("name"), "cwd": snapped.get("cwd"), "uuid": snapped["uuid"],
                         "argv": snapped.get("argv"), "label": None, "title": snapped.get("title"),
                         "slept_at": "unknown", "phase": "recovered"}
                journal[pane] = entry
                write_json(JOURNAL, journal)  # persist before trying, so a refusal leaves it listed
                targets = [entry]
        failures = 0
        for e in targets:
            try:
                failures += not wake_entry(e)
            except SleeperError as exc:
                say(f"cannot wake {wake_name(e)}: {exc}; entry kept")
                failures += 1
    return 1 if failures else 0


