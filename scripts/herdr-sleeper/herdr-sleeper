def cmd_log(args: argparse.Namespace) -> int:
    if not EVENTS.exists():
        print("no events yet")
        return 0
    lines = EVENTS.read_text().splitlines()[-args.n:]
    if args.json:
        print("[" + ",".join(lines) + "]")
        return 0
    for line in lines:
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            print(f"(unreadable event line: {line[:60]!r})")
            continue
        detail = e.get("reason") or e.get("outcome") or e.get("title") or ""
        print(f"{e['at']}  {e['event']:14} {e.get('name') or '-':20} {e.get('pane') or '-':8} {detail}")
    return 0


